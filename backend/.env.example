# 시드 스크립트용 비밀번호 (scripts/seed-news-voca.js, seed-synonym.js, seed-easy-voca.js)
# 설정하지 않으면 시드 스크립트 실행 시 오류 발생
SEED_PASSWORD=your_seed_password

# (선택) 시드 스크립트 API 주소 — 없으면 http://localhost:3000
API_BASE=http://localhost:3000
# 라이브 업로드 시: API_BASE=https://port-0-englishwitheasyword-backend-1272llwoib16o.sel5.cloudtype.app

# (선택) 관리자 삭제용
# ADMIN_PASSWORD=your_admin_password

# (선택) 설정하면 글 생성 POST에 X-Write-Token 헤더 필수 — 스팸/무단 게시 방지
# WRITE_API_TOKEN=long_random_secret
# 시드 스크립트는 writeAuthHeaders() 로 자동 첨부 (loadEnv.js)
