{
  "name": "englishwitheasyword-backend",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "assert:quiz-track": "node scripts/assert-quiz-track-format.js",
    "regenerate:quiz-seo": "node scripts/regenerate-quiz-seo-track.js && node scripts/assert-quiz-track-format.js",
    "quiz:migrate": "node scripts/word-meaning-quiz-migrate.js",
    "quiz:sync-sources": "node scripts/word-meaning-quiz-sync-sources.js",
    "quiz:fill-meanings": "node scripts/word-meaning-quiz-fill-meanings.js",
    "quiz:refresh-meanings": "node scripts/word-meaning-quiz-refresh-meanings.js",
    "quiz:export-review": "node scripts/word-meaning-quiz-export-review.js",
    "quiz:import-review": "node scripts/word-meaning-quiz-import-review.js"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "7.1.0",
    "bcrypt": "6.0.0",
    "body-parser": "2.3.0",
    "cors": "2.8.6",
    "dotenv": "18.0.4",
    "express": "4.21.2",
    "express-session": "1.19.0",
    "mongoose": "8.19.1",
    "openai": "4.104.0",
    "rss": "1.2.2"
  }
}
